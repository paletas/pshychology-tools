{
  "name": "wisc3-e2e",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "old:publish": "node scripts/old-publish.mjs",
    "test:behaviour": "playwright test -c playwright.behaviour.config.ts",
    "test:prefix": "playwright test -c playwright.prefix.config.ts",
    "test:pair": "playwright test -c playwright.pair.config.ts",
    "test:prod": "playwright test -c playwright.prod.config.ts",
    "test:compare": "node scripts/run-compare.mjs",
    "test:timing": "playwright test -c playwright.compare.config.ts --project=timing",
    "report:flagged": "tsx scripts/flagged-issues.ts",
    "report:corrections": "tsx scripts/corrections-report.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
